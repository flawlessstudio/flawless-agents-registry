{
  "name": "flawless-agents-registry",
  "version": "1.0.0",
  "description": "Canonical, audited registry of AI agent infrastructure candidates across 12 layers",
  "private": true,
  "scripts": {
    "validate": "npm run validate:syntax && npm run validate:schema && npm run validate:recipes",
    "validate:syntax": "node scripts/validate-syntax.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
