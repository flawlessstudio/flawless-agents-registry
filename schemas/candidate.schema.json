{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/flawlessstudio/flawless-agents-registry/schemas/candidate.schema.json",
  "title": "Registry Candidate",
  "description": "Schema for a single AI agents registry candidate entry",
  "type": "object",
  "required": ["id", "name", "status", "category", "source", "pricing", "deployment", "api"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Kebab-case unique identifier"
    },
    "name": { "type": "string", "minLength": 2 },
    "status": {
      "type": "string",
      "enum": ["core", "monitoring", "deprecated"]
    },
    "category": { "type": "string", "minLength": 2 },
    "source": { "type": "string", "format": "uri" },
    "pricing": {
      "type": "string",
      "enum": ["oss", "free", "freemium", "paid", "enterprise"]
    },
    "deployment": {
      "type": "string",
      "enum": ["cloud", "self-hosted", "hybrid"]
    },
    "api": { "type": "boolean" },
    "notes": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
