{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flawlessstudio/flawless-agents-registry/schemas/registry.schema.json",
  "title": "Flawless Agents Registry Index",
  "description": "Top-level index schema for registry.core.json and registry.watchlist.json.",
  "type": "object",
  "required": ["version", "generated_at", "tier", "total_candidates", "layers"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tier": { "type": "string", "enum": ["core", "watchlist"] },
    "total_candidates": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "name", "ref"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string", "pattern": "^L([1-9]|1[0-2])$" },
          "name": { "type": "string" },
          "tier": { "type": "string", "enum": ["APEX", "HYBRID"] },
          "ref": { "type": "string", "description": "Relative path to the layer JSON file" }
        }
      }
    }
  }
}
