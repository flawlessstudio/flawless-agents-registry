{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flawlessstudio/flawless-agents-registry/schemas/stack_recipes.schema.json",
  "title": "Stack Recipes",
  "description": "Schema for stack_recipes.json files within each layer or at registry root",
  "type": "object",
  "required": ["layer", "stack_recipes"],
  "additionalProperties": false,
  "properties": {
    "layer": { "type": "string" },
    "stack_recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "stack", "use_case"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
          "name": { "type": "string", "minLength": 3 },
          "stack": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": { "type": "string" }
          },
          "layers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "use_case": { "type": "string", "minLength": 10 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
